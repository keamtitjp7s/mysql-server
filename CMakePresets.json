{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "CXXFLAGS": "-O3 -DNDEBUG"
      }
    },
    {
      "name": "linux-debug",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-minimal",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_DEBUG": "OFF",
        "WITH_EMBEDDED_SERVER": "OFF",
        "WITH_ARCHIVE_STORAGE_ENGINE": "OFF",
        "WITH_BLACKHOLE_STORAGE_ENGINE": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-components-only",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-components",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WITH_SERVER": "OFF",
        "WITH_NDBCLUSTER": "OFF",
        "WITH_UNIT_TESTS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "CXXFLAGS": "-fPIC"
      }
    },
    {
      "name": "macos-release",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-debug",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-vs2019",
      "hidden": false,
      "generator": "Visual Studio 16 2019",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-vs2019",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug;RelWithDebInfo;MinSizeRel",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2019-minimal",
      "hidden": false,
      "generator": "Visual Studio 16 2019",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-vs2019-minimal",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "WITH_DEBUG": "OFF",
        "WITH_EMBEDDED_SERVER": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-minimal",
      "configurePreset": "linux-minimal",
      "configuration": "Release"
    },
    {
      "name": "linux-components-only",
      "configurePreset": "linux-components-only",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2019",
      "configurePreset": "windows-vs2019",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2019-minimal",
      "configurePreset": "windows-vs2019-minimal",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-release-test",
      "configurePreset": "linux-release",
      "output": {
        "verbosity": "verbose"
      }
    },
    {
      "name": "linux-debug-test",
      "configurePreset": "linux-debug",
      "output": {
        "verbosity": "verbose"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-full",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        }
      ]
    },
    {
      "name": "macos-full",
      "steps": [
        {
          "type": "configure",
          "name": "macos-release"
        },
        {
          "type": "build",
          "name": "macos-release"
        }
      ]
    }
  ]
}
